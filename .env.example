# Database (host-run PostgreSQL — see DEPLOYMENT_GUIDE.md)
# POSTGRES_HOST is forced to host.docker.internal in docker-compose.yml; kept here for local/dev reference.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Networking
# Comma-separated or JSON array of allowed origins for the backend's CORS middleware.
BACKEND_CORS_ORIGINS=

# Auth
# Secret key used to sign JWTs — generate with `openssl rand -hex 32`.
SECRET_KEY=
# JWT signing algorithm.
ALGORITHM=HS256
# Access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=300
